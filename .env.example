# Chạy npm run setup để sinh .env và khóa RSA riêng trên máy.
GATEWAY_PORT=8080
USER_PORT=3001
ORDER_PORT=3002
USER_URL=http://127.0.0.1:3001
ORDER_URL=http://127.0.0.1:3002
JWT_PRIVATE_KEY_FILE=.secrets/private.pem
JWT_PUBLIC_KEY_FILE=.secrets/public.pem
INTERNAL_API_KEY=GENERATE_WITH_NPM_RUN_SETUP
DEMO_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
MINIO_ROOT_USER=labstorage
MINIO_ROOT_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=avatars
